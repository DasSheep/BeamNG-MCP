# --- Local reference material ------------------------------------------------------
# Optional local copies of the game's Lua tree and other reference code for development.
# License-bound: never commit.
/.sample/

# --- BeamNG mod build artifacts --------------------------------------------------
*.zip
dist/
build/

# --- Lua -------------------------------------------------------------------------
*.luac

# --- Node (optional tooling: MCP Inspector / conformance harness) -----------------
node_modules/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# --- Logs / scratch --------------------------------------------------------------
*.log
.playwright-mcp/
tmp/
scratch/

# --- OS / editor -----------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
# Codex CLI local config (machine-local, points at the loopback MCP server)
.codex/
# Grok CLI local config (machine-local agent config)
.grok/

# --- Agent tooling (machine-local generated exports — NOT the runtime source) -----
# The MCP server reads tool defs from the Lua M.def tables; these are generated
# side-exports that can drift, so they're not tracked. Regenerated by their tooling.
mcps/
agent-tools/

# --- Env / secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# BeamMP deployment secrets and transient IPC
/beammp/BeamMCP/config.json
/beammp/BeamMCP/token
/beammp/BeamMCP/.runtime/
